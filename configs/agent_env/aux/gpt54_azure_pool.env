# External GPT-5.4 endpoint pool for ROPD rubric/judge calls.
# This profile does not start a local aux model. Secrets stay outside git.

AUX_SPEC=${AUX_SPEC:-openai/gpt-5.4-2026-03-05}
AUX_BASE_URL=${AUX_BASE_URL:-https://gpt-i18n.byteintl.net/gpt/openapi/online/v2/crawl/openai/deployments/gpt_openapi}
AUX_API_KEY_PATH=${AUX_API_KEY_PATH:-${ROOT_DIR}/secrets/gpt54_key_1}
AUX_TIMEOUT_S=${AUX_TIMEOUT_S:-300}
AUX_MAX_TOKENS=${AUX_MAX_TOKENS:-16384}
AUX_TEMPERATURE=${AUX_TEMPERATURE:-0.0}
AUX_TOP_P=${AUX_TOP_P:-1.0}
AUX_ENABLE_THINKING=${AUX_ENABLE_THINKING:-0}
AUX_SEPARATE_REASONING=${AUX_SEPARATE_REASONING:-1}

AUX_RUBRIC_POOL_PATH=${AUX_RUBRIC_POOL_PATH:-${ROOT_DIR}/secrets/ropd_gpt54_pool.jsonl}
AUX_JUDGE_POOL_PATH=${AUX_JUDGE_POOL_PATH:-${ROOT_DIR}/secrets/ropd_gpt54_pool.jsonl}
AUX_TRAIN_ENV_KEYS=${AUX_TRAIN_ENV_KEYS:-"AUX_RUBRIC_POOL_PATH AUX_JUDGE_POOL_PATH"}
