# Auxiliary OpenAI-compatible endpoint backed by DeepSeek Flash API.

AUX_SPEC=${AUX_SPEC:-deepseek/deepseek-v4-flash}
AUX_BASE_URL=${AUX_BASE_URL:-https://api.deepseek.com}
AUX_API_KEY_PATH=${AUX_API_KEY_PATH:-${ROOT_DIR}/secrets/deepseek_api_key}
AUX_TIMEOUT_S=${AUX_TIMEOUT_S:-300}
AUX_MAX_TOKENS=${AUX_MAX_TOKENS:-1024}
AUX_TEMPERATURE=${AUX_TEMPERATURE:-0.0}
AUX_TOP_P=${AUX_TOP_P:-1.0}
AUX_ENABLE_THINKING=${AUX_ENABLE_THINKING:-0}
AUX_SEPARATE_REASONING=${AUX_SEPARATE_REASONING:-1}
