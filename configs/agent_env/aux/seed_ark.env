# Auxiliary OpenAI-compatible endpoint backed by Seed/Ark API.

AUX_SPEC=${AUX_SPEC:-ark/ep-20260224141309-hbddk}
AUX_BASE_URL=${AUX_BASE_URL:-https://ark-cn-beijing.bytedance.net/api/v3}
AUX_API_KEY_PATH=${AUX_API_KEY_PATH:-${ROOT_DIR}/secrets/ark_seed18_key_2}
AUX_TIMEOUT_S=${AUX_TIMEOUT_S:-180}
AUX_MAX_TOKENS=${AUX_MAX_TOKENS:-512}
AUX_TEMPERATURE=${AUX_TEMPERATURE:-0.0}
AUX_TOP_P=${AUX_TOP_P:-1.0}
AUX_ENABLE_THINKING=${AUX_ENABLE_THINKING:-0}
AUX_SEPARATE_REASONING=${AUX_SEPARATE_REASONING:-1}

# Optional named aux endpoints for reward pipelines that need separate LLM roles.
# Stage concurrency belongs to reward.ropd.* in the selected reward profile, not this aux endpoint profile.
AUX_RUBRIC_PROVIDER=${AUX_RUBRIC_PROVIDER:-ark}
AUX_RUBRIC_BASE_URL=${AUX_RUBRIC_BASE_URL:-https://ark-cn-beijing.bytedance.net/api/v3}
AUX_RUBRIC_MODEL=${AUX_RUBRIC_MODEL:-ep-20260112175207-f5mrl}
AUX_RUBRIC_API_KEY_PATH=${AUX_RUBRIC_API_KEY_PATH:-${ROOT_DIR}/secrets/ark_seed18_key_1}
AUX_JUDGE_PROVIDER=${AUX_JUDGE_PROVIDER:-ark}
AUX_JUDGE_BASE_URL=${AUX_JUDGE_BASE_URL:-https://ark-cn-beijing.bytedance.net/api/v3}
AUX_JUDGE_MODEL=${AUX_JUDGE_MODEL:-ep-20260224141309-hbddk}
AUX_JUDGE_API_KEY_PATH=${AUX_JUDGE_API_KEY_PATH:-${ROOT_DIR}/secrets/ark_seed18_key_2}
AUX_TRAIN_ENV_KEYS=${AUX_TRAIN_ENV_KEYS:-"AUX_RUBRIC_PROVIDER AUX_RUBRIC_BASE_URL AUX_RUBRIC_MODEL AUX_RUBRIC_API_KEY_PATH AUX_JUDGE_PROVIDER AUX_JUDGE_BASE_URL AUX_JUDGE_MODEL AUX_JUDGE_API_KEY_PATH"}
