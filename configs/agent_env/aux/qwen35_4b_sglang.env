# Auxiliary OpenAI-compatible endpoint backed by local Qwen3.5-4B SGLang.
# Intended for fast reward/ROPD smoke tests.

AUX_SPEC=${AUX_SPEC:-sglang/Qwen3.5-4B}
AUX_MODEL_PATH=${AUX_MODEL_PATH:-${LOCAL_RUNTIME_DIR:-/tmp/server-ops-runtime}/models/Qwen3.5-4B}
AUX_PYTHON=${AUX_PYTHON:-/usr/bin/python}
AUX_SERVE_PYTHON=${AUX_SERVE_PYTHON:-${AUX_PYTHON}}
AUX_SERVED_MODEL_NAME=${AUX_SERVED_MODEL_NAME:-qwen3.5-4b-aux}
AUX_TP=${AUX_TP:-1}
AUX_PP=${AUX_PP:-1}
AUX_MEM_FRACTION=${AUX_MEM_FRACTION:-0.30}
AUX_MAX_MODEL_LEN=${AUX_MAX_MODEL_LEN:-8192}
AUX_TOOL_CALL_PARSER=${AUX_TOOL_CALL_PARSER:-qwen}
AUX_REASONING_PARSER=${AUX_REASONING_PARSER:-qwen3}
AUX_TIMEOUT_S=${AUX_TIMEOUT_S:-120}
AUX_MAX_TOKENS=${AUX_MAX_TOKENS:-512}
AUX_TEMPERATURE=${AUX_TEMPERATURE:-0.0}
AUX_TOP_P=${AUX_TOP_P:-1.0}
AUX_ENABLE_THINKING=${AUX_ENABLE_THINKING:-0}
AUX_SEPARATE_REASONING=${AUX_SEPARATE_REASONING:-1}
