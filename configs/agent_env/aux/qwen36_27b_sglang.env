# Auxiliary OpenAI-compatible endpoint backed by local Qwen3.6-27B SGLang.
# The aux node is outside Ray training resources.

AUX_SPEC=${AUX_SPEC:-sglang/Qwen3.6-27B}
AUX_PYTHON=${AUX_PYTHON:-${LOCAL_ENVS_DIR:-/tmp/server-ops-envs}/slime/bin/python}
AUX_SERVED_MODEL_NAME=${AUX_SERVED_MODEL_NAME:-qwen3.6-27b-aux}
AUX_TP=${AUX_TP:-8}
AUX_PP=${AUX_PP:-1}
AUX_MEM_FRACTION=${AUX_MEM_FRACTION:-0.65}
AUX_MAX_MODEL_LEN=${AUX_MAX_MODEL_LEN:-16384}
AUX_TOOL_CALL_PARSER=${AUX_TOOL_CALL_PARSER:-qwen}
AUX_REASONING_PARSER=${AUX_REASONING_PARSER:-qwen3}
AUX_TIMEOUT_S=${AUX_TIMEOUT_S:-300}
AUX_MAX_TOKENS=${AUX_MAX_TOKENS:-512}
AUX_TEMPERATURE=${AUX_TEMPERATURE:-0.0}
AUX_TOP_P=${AUX_TOP_P:-1.0}
AUX_ENABLE_THINKING=${AUX_ENABLE_THINKING:-0}
AUX_SEPARATE_REASONING=${AUX_SEPARATE_REASONING:-1}
