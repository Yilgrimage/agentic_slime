# WebShop GRPO full-async run with ROPD reward from selected teacher traces.

ENV_NAME=${ENV_NAME:-webshop}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/webshop/env_config.yaml}
REWARD_PROFILE=${REWARD_PROFILE:-configs/agent_env/rewards/webshop_ropd_qwen_aux.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/3train_1aux.env}
MODEL_PROFILE=${MODEL_PROFILE:-configs/agent_env/models/qwen3_4b.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/webshop_grpo_fullasync_3x8.env}
AUX_PROFILE=${AUX_PROFILE:-configs/agent_env/aux/qwen36_27b_sglang.env}

PROMPT_NUM_TASKS=${PROMPT_NUM_TASKS:-all}
PROMPT_DATA_EXTRA_ARGS=${PROMPT_DATA_EXTRA_ARGS:-"--task-id-file ${ROOT_DIR}/data/teacher_traces/processed/webshop_deepseek_v4_flash_bestofn_teacher_score1.jsonl"}
