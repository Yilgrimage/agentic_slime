# AppWorld GRPO full-async run with env-success outcome, mask-only CA-B, LUFFY,
# and the external GPT-5.4 judge pool.

ENV_NAME=${ENV_NAME:-appworld}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/appworld/env_config.yaml}
REWARD_PROFILE=${REWARD_PROFILE:-configs/agent_env/rewards/appworld_ropd_ca_b_luffy_gpt54_pool.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/4train_8gpu.env}
MODEL_PROFILE=${MODEL_PROFILE:-configs/agent_env/models/qwen3_4b.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/appworld_grpo_fullasync_4x8.env}
AUX_PROFILE=${AUX_PROFILE:-configs/agent_env/aux/gpt54_azure_pool.env}

PROMPT_NUM_TASKS=${PROMPT_NUM_TASKS:-all}
PROMPT_DATA_EXTRA_ARGS=${PROMPT_DATA_EXTRA_ARGS:-"--task-id-file ${ROOT_DIR}/data/teacher_traces/processed/appworld_deepseek_v4_flash_train_bestofn_teacher_clean_trace.jsonl"}
FORCE_PROMPT_DATA=${FORCE_PROMPT_DATA:-1}
ENABLE_DYNAMIC_SAMPLING_FILTER=${ENABLE_DYNAMIC_SAMPLING_FILTER:-1}

TOTAL_NUM_STEPS=${TOTAL_NUM_STEPS:-300}
NUM_STEPS=${NUM_STEPS:-${TOTAL_NUM_STEPS}}
NUM_ROLLOUT=${NUM_ROLLOUT:-${TOTAL_NUM_STEPS}}
SAVE_INTERVAL=${SAVE_INTERVAL:-50}
AGENT_ENV_MAX_CHECKPOINTS=${AGENT_ENV_MAX_CHECKPOINTS:-0}

EXP_PROJECT=${EXP_PROJECT:-${PROJECT_NAME:-Qwen3-4B_appworld_ropd_grpo}}
EXP_NAME=${EXP_NAME:-${RUN_NAME:-appworld-Qwen3-4B-grpo-fullasync-4x8-ca-b-maskonly-luffy-gpt54pool-warm99to300-s50}}
