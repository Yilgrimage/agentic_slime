# AppWorld GRPO full-async run with TASA-GAE credit assignment, GPT-5.4 judge pool, and LUFFY.

ENV_NAME=${ENV_NAME:-appworld}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/appworld/env_config.yaml}
REWARD_PROFILE=${REWARD_PROFILE:-configs/agent_env/rewards/appworld_ropd_tasa_gae_luffy_gpt54_pool.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/4train_8gpu.env}
MODEL_PROFILE=${MODEL_PROFILE:-configs/agent_env/models/qwen3_4b.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/appworld_grpo_fullasync_4x8.env}
AUX_PROFILE=${AUX_PROFILE:-configs/agent_env/aux/gpt54_azure_pool.env}

PROMPT_NUM_TASKS=${PROMPT_NUM_TASKS:-all}
PROMPT_DATA_EXTRA_ARGS=${PROMPT_DATA_EXTRA_ARGS:-"--task-id-file ${ROOT_DIR}/data/teacher_traces/processed/appworld_deepseek_v4_structured_train_bestofn_teacher.jsonl"}
FORCE_PROMPT_DATA=${FORCE_PROMPT_DATA:-1}

# TASA estimates leave-one-out state values from peer trajectories. Use 16
# samples per task while keeping each actor update at 128 samples.
N_SAMPLES_PER_PROMPT=${N_SAMPLES_PER_PROMPT:-16}
ROLLOUT_BATCH_SIZE=${ROLLOUT_BATCH_SIZE:-8}
GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-128}
AGENT_ENV_ASYNC_MAX_INFLIGHT_GROUPS=${AGENT_ENV_ASYNC_MAX_INFLIGHT_GROUPS:-8}

# TASA-GAE can produce useful token-level advantages even when all scalar
# outcome rewards in a group are zero, so scalar zero-variance filtering is off.
ENABLE_DYNAMIC_SAMPLING_FILTER=${ENABLE_DYNAMIC_SAMPLING_FILTER:-0}

TOTAL_NUM_STEPS=${TOTAL_NUM_STEPS:-300}
NUM_STEPS=${NUM_STEPS:-${TOTAL_NUM_STEPS}}
NUM_ROLLOUT=${NUM_ROLLOUT:-${TOTAL_NUM_STEPS}}
SAVE_INTERVAL=${SAVE_INTERVAL:-50}
AGENT_ENV_MAX_CHECKPOINTS=${AGENT_ENV_MAX_CHECKPOINTS:-0}

# Preserve one auditable Judge group and one token-credit trace per training
# step. These bounded artifacts are part of the formal TASA evidence, not a
# full rollout debug dump.
AGENT_ENV_ROPD_DUMP_N=${AGENT_ENV_ROPD_DUMP_N:-1}
AGENT_ENV_ROPD_DUMP_TOTAL_N=${AGENT_ENV_ROPD_DUMP_TOTAL_N:-300}
AGENT_ENV_CREDIT_DUMP_N=${AGENT_ENV_CREDIT_DUMP_N:-1}
AGENT_ENV_CREDIT_DUMP_TOTAL_N=${AGENT_ENV_CREDIT_DUMP_TOTAL_N:-300}

EXP_PROJECT=${EXP_PROJECT:-${PROJECT_NAME:-Qwen3-4B_appworld_ropd_grpo}}
EXP_NAME=${EXP_NAME:-${RUN_NAME:-appworld-Qwen3-4B-grpo-fullasync-4x8-ropd-tasa-gae-luffy-gpt54pool-fresh0to300-s50}}
