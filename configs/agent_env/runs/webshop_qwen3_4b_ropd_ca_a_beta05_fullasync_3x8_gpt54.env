# WebShop full-async GRPO with env-score outcome and additive ROPD-CA process credit.
# This profile keeps raw process-credit semantics and raises beta to 0.5.

ENV_NAME=${ENV_NAME:-webshop}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/webshop/env_config.yaml}
REWARD_PROFILE=${REWARD_PROFILE:-configs/agent_env/rewards/webshop_ropd_ca_a_beta05_gpt54_pool.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/3train_8gpu.env}
MODEL_PROFILE=${MODEL_PROFILE:-configs/agent_env/models/qwen3_4b.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/webshop_grpo_fullasync_3x8.env}
AUX_PROFILE=${AUX_PROFILE:-configs/agent_env/aux/gpt54_azure_pool.env}

PROMPT_NUM_TASKS=${PROMPT_NUM_TASKS:-all}
PROMPT_DATA_EXTRA_ARGS=${PROMPT_DATA_EXTRA_ARGS:-"--task-id-file ${ROOT_DIR}/data/webshop/teacher_data/trace.jsonl"}
FORCE_PROMPT_DATA=${FORCE_PROMPT_DATA:-1}

TOTAL_NUM_STEPS=${TOTAL_NUM_STEPS:-300}
NUM_STEPS=${NUM_STEPS:-${TOTAL_NUM_STEPS}}
NUM_ROLLOUT=${NUM_ROLLOUT:-${TOTAL_NUM_STEPS}}
SAVE_INTERVAL=${SAVE_INTERVAL:-50}
AGENT_ENV_MAX_CHECKPOINTS=${AGENT_ENV_MAX_CHECKPOINTS:-0}
NO_SAVE_OPTIM=${NO_SAVE_OPTIM:-0}

EXP_PROJECT=${EXP_PROJECT:-${PROJECT_NAME:-Qwen3-4B_webshop_grpo}}
EXP_NAME=${EXP_NAME:-${RUN_NAME:-webshop-Qwen3-4B-grpo-fullasync-3x8-ropd-ca-a-raw-beta05-gpt54pool-envscore-thinking-nokl-300s50}}
