# AppWorld GRPO full-async run with binary env-success reward.

ENV_NAME=${ENV_NAME:-appworld}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/appworld/env_config.yaml}
REWARD_PROFILE=${REWARD_PROFILE:-configs/agent_env/rewards/appworld_success_legacy.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/4train_8gpu.env}
MODEL_PROFILE=${MODEL_PROFILE:-configs/agent_env/models/qwen3_4b.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/appworld_grpo_fullasync_4x8.env}
AUX_PROFILE=${AUX_PROFILE-}

PROMPT_NUM_TASKS=${PROMPT_NUM_TASKS:-all}
FORCE_PROMPT_DATA=${FORCE_PROMPT_DATA:-1}
ENABLE_DYNAMIC_SAMPLING_FILTER=${ENABLE_DYNAMIC_SAMPLING_FILTER:-0}

TOTAL_NUM_STEPS=${TOTAL_NUM_STEPS:-200}
NUM_STEPS=${NUM_STEPS:-${TOTAL_NUM_STEPS}}
NUM_ROLLOUT=${NUM_ROLLOUT:-${TOTAL_NUM_STEPS}}
SAVE_INTERVAL=${SAVE_INTERVAL:-50}
NO_SAVE_OPTIM=${NO_SAVE_OPTIM:-0}

EXP_PROJECT=${EXP_PROJECT:-${PROJECT_NAME:-Qwen3-4B_appworld_grpo}}
EXP_NAME=${EXP_NAME:-${RUN_NAME:-appworld-Qwen3-4B-grpo-fullasync-4x8-success01-200s-save50}}
