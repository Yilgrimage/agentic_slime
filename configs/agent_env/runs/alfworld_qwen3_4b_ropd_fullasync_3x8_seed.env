# ALFWorld GRPO full-async run with ROPD reward from GPT-OSS teacher traces.

ENV_NAME=${ENV_NAME:-alfworld}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/alfworld/env_config.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/3train_8gpu.env}
MODEL_PROFILE=${MODEL_PROFILE:-configs/agent_env/models/qwen3_4b.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/alfworld_grpo_fullasync_3x8.env}
AUX_PROFILE=${AUX_PROFILE:-configs/agent_env/aux/seed_ark.env}

AGENT_ENV_RM_IMPL=${AGENT_ENV_RM_IMPL:-ropd}
AGENT_ENV_JUDGE_MODE=${AGENT_ENV_JUDGE_MODE:-aux}
AGENT_ENV_ROPD_TEACHER_FILE=${AGENT_ENV_ROPD_TEACHER_FILE:-${ROOT_DIR}/data/teacher_traces/processed/alfworld_gpt_oss_120b_ropd_teacher.jsonl}
AGENT_ENV_ROPD_ALLOW_ONLINE_RUBRIC=${AGENT_ENV_ROPD_ALLOW_ONLINE_RUBRIC:-1}
PROMPT_USE_SERVER_NUM_TASKS=${PROMPT_USE_SERVER_NUM_TASKS:-0}
PROMPT_NUM_TASKS=${PROMPT_NUM_TASKS:-all}
PROMPT_DATA_EXTRA_ARGS=${PROMPT_DATA_EXTRA_ARGS:-"--task-id-file ${AGENT_ENV_ROPD_TEACHER_FILE}"}

EXP_PROJECT=${EXP_PROJECT:-${PROJECT_NAME:-Qwen3-4B_alfworld_ropd_grpo}}
EXP_NAME=${EXP_NAME:-${RUN_NAME:-alfworld-Qwen3-4B-grpo-fullasync-3x8-ropd-gptoss-seed}}
