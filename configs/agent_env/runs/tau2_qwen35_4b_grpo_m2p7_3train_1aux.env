# Tau2 GRPO run wiring. This file selects env, topology, train, and aux profiles.

ENV_NAME=${ENV_NAME:-tau2}
ENV_RUN_SCRIPT=${ENV_RUN_SCRIPT:-examples/agent_env/tau2/scripts/run_tau2_grpo.sh}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/tau2/train_config.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/3train_1aux.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/qwen35_4b_grpo.env}
AUX_PROFILE=${AUX_PROFILE:-configs/agent_env/aux/minimax_m27_vllm.env}

MODEL_BASENAME=${MODEL_BASENAME:-Qwen3.5-4B}
EXP_PROJECT=${EXP_PROJECT:-${PROJECT_NAME:-${MODEL_BASENAME}_tau2_grpo}}
EXP_NAME=${EXP_NAME:-${RUN_NAME:-tau2-areal-${MODEL_BASENAME}-grpo-m2p7-3train-1aux-pool128-gbs128-rb16-n8-tp4-cp1-mtpgpu16384-logpchunk1024}}
