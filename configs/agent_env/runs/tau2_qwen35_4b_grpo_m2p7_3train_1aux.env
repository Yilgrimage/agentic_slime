# Tau2 GRPO run wiring. This file selects env, reward, topology, train, and aux profiles.

ENV_NAME=${ENV_NAME:-tau2}
ENV_CONFIG=${ENV_CONFIG:-examples/agent_env/tau2/env_config.yaml}
REWARD_PROFILE=${REWARD_PROFILE:-configs/agent_env/rewards/tau2_legacy.yaml}

TOPOLOGY_PROFILE=${TOPOLOGY_PROFILE:-configs/agent_env/topology/3train_1aux.env}
MODEL_PROFILE=${MODEL_PROFILE:-configs/agent_env/models/qwen35_4b.env}
TRAIN_PROFILE=${TRAIN_PROFILE:-configs/agent_env/train/tau2_grpo_fullasync_3x8.env}
AUX_PROFILE=${AUX_PROFILE:-configs/agent_env/aux/minimax_m27_vllm.env}

EXP_PROJECT=${EXP_PROJECT:-${PROJECT_NAME:-Qwen3.5-4B_tau2_grpo}}
EXP_NAME=${EXP_NAME:-${RUN_NAME:-tau2-areal-Qwen3.5-4B-grpo-m2p7-3train-1aux-pool128-gbs128-rb16-n8-tp4-cp1-mtpgpu16384-logpchunk1024}}
