# MCP-server GRPO sync smoke profile for 1x8 GPU colocated training.

TRAIN_ENTRYPOINT=${TRAIN_ENTRYPOINT:-examples/agent_env/train_entrypoint.py}
AGENT_ENV_TRAIN_LOOP=${AGENT_ENV_TRAIN_LOOP:-sync}
ROLLOUT_FUNCTION_PATH=${ROLLOUT_FUNCTION_PATH:-slime.rollout.sglang_rollout.generate_rollout}
COLOCATE=${COLOCATE:-1}

WANDB_PROJECT=${WANDB_PROJECT:-${EXP_PROJECT}}
WANDB_ENTITY=${WANDB_ENTITY:-yilgrimage-bytedance}
WANDB_GROUP=${WANDB_GROUP:-${EXP_NAME}}
ENABLE_WANDB=${ENABLE_WANDB:-0}

TOTAL_NUM_STEPS=${TOTAL_NUM_STEPS:-1}
NUM_STEPS=${NUM_STEPS:-${TOTAL_NUM_STEPS}}
NUM_ROLLOUT=${NUM_ROLLOUT:-${TOTAL_NUM_STEPS}}
START_ROLLOUT_ID=${START_ROLLOUT_ID:-0}
SAVE_INTERVAL=${SAVE_INTERVAL:-${TOTAL_NUM_STEPS}}
AGENT_ENV_MAX_CHECKPOINTS=${AGENT_ENV_MAX_CHECKPOINTS:-1}
NO_SAVE_OPTIM=${NO_SAVE_OPTIM:-1}
ASYNC_SAVE=${ASYNC_SAVE:-0}
RESUME_FROM=${RESUME_FROM:-}
SEED=${SEED:-42}

PROMPT_NUM_TASKS=${PROMPT_NUM_TASKS:-4}
ROLLOUT_BATCH_SIZE=${ROLLOUT_BATCH_SIZE:-4}
N_SAMPLES_PER_PROMPT=${N_SAMPLES_PER_PROMPT:-2}
GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-8}
ROLLOUT_MAX_CONTEXT_LEN=${ROLLOUT_MAX_CONTEXT_LEN:-8192}
ROLLOUT_MAX_RESPONSE_LEN=${ROLLOUT_MAX_RESPONSE_LEN:-512}
MAX_TOKENS_PER_GPU=${MAX_TOKENS_PER_GPU:-4096}
LOG_PROBS_CHUNK_SIZE=${LOG_PROBS_CHUNK_SIZE:-16}
TRAIN_MEMORY_MARGIN_BYTES=${TRAIN_MEMORY_MARGIN_BYTES:-0}
SGLANG_SERVER_CONCURRENCY=${SGLANG_SERVER_CONCURRENCY:-1}
SGLANG_MEM_FRACTION_STATIC=${SGLANG_MEM_FRACTION_STATIC:-0.25}

ACTOR_NUM_NODES=${ACTOR_NUM_NODES:-1}
ACTOR_GPUS=${ACTOR_GPUS:-8}
ROLLOUT_GPUS=${ROLLOUT_GPUS:-8}
NUM_GPUS=${NUM_GPUS:-8}
TP_SIZE=${TP_SIZE:-1}
CP_SIZE=${CP_SIZE:-1}
MODEL_EXTRA_ARGS="${MODEL_EXTRA_ARGS:-} --attention-backend flash"

USE_KL_LOSS=${USE_KL_LOSS:-0}
KL_LOSS_COEF=${KL_LOSS_COEF:-0.00}
USE_ROLLOUT_LOGPROBS=${USE_ROLLOUT_LOGPROBS:-0}
REWARDS_NORMALIZATION=${REWARDS_NORMALIZATION:-1}
GRPO_STD_NORMALIZATION=${GRPO_STD_NORMALIZATION:-1}
FORCE_PROMPT_DATA=${FORCE_PROMPT_DATA:-1}
APPLY_CHAT_TEMPLATE=${APPLY_CHAT_TEMPLATE:-1}
DYNAMIC_SAMPLING_FILTER_PATH=${DYNAMIC_SAMPLING_FILTER_PATH:-}
ROLLOUT_SAMPLE_FILTER_PATH=${ROLLOUT_SAMPLE_FILTER_PATH:-}
SAVE_DEBUG_TRAIN_DATA=${SAVE_DEBUG_TRAIN_DATA:-1}
SAVE_DEBUG_TRAIN_DATA_PATH=${SAVE_DEBUG_TRAIN_DATA_PATH:-}

AGENT_ENV_ROLLOUT_DUMP_N=${AGENT_ENV_ROLLOUT_DUMP_N:-2}
AGENT_ENV_ROLLOUT_DUMP_DISCARD_N=${AGENT_ENV_ROLLOUT_DUMP_DISCARD_N:-2}
AGENT_ENV_ROLLOUT_DUMP_TRACE=${AGENT_ENV_ROLLOUT_DUMP_TRACE:-both}
