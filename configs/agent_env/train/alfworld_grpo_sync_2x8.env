# ALFWorld GRPO sync profile for 2x8 GPU colocated training.

TRAIN_ENTRYPOINT=${TRAIN_ENTRYPOINT:-examples/agent_env/train_entrypoint.py}
AGENT_ENV_TRAIN_LOOP=${AGENT_ENV_TRAIN_LOOP:-sync}
ROLLOUT_FUNCTION_PATH=${ROLLOUT_FUNCTION_PATH:-slime.rollout.sglang_rollout.generate_rollout}
COLOCATE=${COLOCATE:-1}

WANDB_PROJECT=${WANDB_PROJECT:-${EXP_PROJECT}}
WANDB_ENTITY=${WANDB_ENTITY:-yilgrimage-bytedance}
WANDB_GROUP=${WANDB_GROUP:-${EXP_NAME}}
ENABLE_WANDB=${ENABLE_WANDB:-1}

TOTAL_NUM_STEPS=${TOTAL_NUM_STEPS:-150}
NUM_STEPS=${NUM_STEPS:-${TOTAL_NUM_STEPS}}
NUM_ROLLOUT=${NUM_ROLLOUT:-${TOTAL_NUM_STEPS}}
SAVE_INTERVAL=${SAVE_INTERVAL:-${TOTAL_NUM_STEPS}}
NO_SAVE_OPTIM=${NO_SAVE_OPTIM:-1}
ASYNC_SAVE=${ASYNC_SAVE:-0}
RESUME_FROM=${RESUME_FROM:-}
SEED=${SEED:-42}

ROLLOUT_BATCH_SIZE=${ROLLOUT_BATCH_SIZE:-16}
N_SAMPLES_PER_PROMPT=${N_SAMPLES_PER_PROMPT:-8}
GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-128}
ROLLOUT_MAX_CONTEXT_LEN=${ROLLOUT_MAX_CONTEXT_LEN:-16384}
ROLLOUT_MAX_RESPONSE_LEN=${ROLLOUT_MAX_RESPONSE_LEN:-2048}
MAX_TOKENS_PER_GPU=${MAX_TOKENS_PER_GPU:-20480}
LOG_PROBS_CHUNK_SIZE=${LOG_PROBS_CHUNK_SIZE:-1024}
SGLANG_SERVER_CONCURRENCY=${SGLANG_SERVER_CONCURRENCY:-16}
SGLANG_MEM_FRACTION_STATIC=${SGLANG_MEM_FRACTION_STATIC:-0.55}

ACTOR_NUM_NODES=${ACTOR_NUM_NODES:-2}
ACTOR_GPUS=${ACTOR_GPUS:-4}
ROLLOUT_GPUS=${ROLLOUT_GPUS:-8}
NUM_GPUS=${NUM_GPUS:-8}
TP_SIZE=${TP_SIZE:-4}
CP_SIZE=${CP_SIZE:-1}

USE_KL_LOSS=${USE_KL_LOSS:-0}
KL_LOSS_COEF=${KL_LOSS_COEF:-0.00}
USE_ROLLOUT_LOGPROBS=${USE_ROLLOUT_LOGPROBS:-0}
REWARDS_NORMALIZATION=${REWARDS_NORMALIZATION:-1}
GRPO_STD_NORMALIZATION=${GRPO_STD_NORMALIZATION:-1}
FORCE_PROMPT_DATA=${FORCE_PROMPT_DATA:-1}
DYNAMIC_SAMPLING_FILTER_PATH=${DYNAMIC_SAMPLING_FILTER_PATH:-}
ROLLOUT_SAMPLE_FILTER_PATH=${ROLLOUT_SAMPLE_FILTER_PATH:-examples.agent_env.rollout.glm_style_pad_groups_filter}
SAVE_DEBUG_TRAIN_DATA=${SAVE_DEBUG_TRAIN_DATA:-0}
SAVE_DEBUG_TRAIN_DATA_PATH=${SAVE_DEBUG_TRAIN_DATA_PATH:-}

AGENT_ENV_ROLLOUT_DUMP_N=${AGENT_ENV_ROLLOUT_DUMP_N:-4}
AGENT_ENV_ROLLOUT_DUMP_DISCARD_N=${AGENT_ENV_ROLLOUT_DUMP_DISCARD_N:-16}
AGENT_ENV_ROLLOUT_DUMP_TRACE=${AGENT_ENV_ROLLOUT_DUMP_TRACE:-both}
AGENT_ENV_GLM_PADDING_MIN_VALID_FRACTION=${AGENT_ENV_GLM_PADDING_MIN_VALID_FRACTION:-0.5}
AGENT_ENV_GLM_PADDING_MAX_SEEN_GROUPS=${AGENT_ENV_GLM_PADDING_MAX_SEEN_GROUPS:-256}
