# Three Ray/env-server nodes, eight visible GPUs per node.

NODES_FILE=${NODES_FILE:-configs/nodes/agent_env_all.txt}
NODE_INDICES=${NODE_INDICES:-0,1,2}

ENV_PORT=${ENV_PORT:-18182}
ROUTER_PORT=${ROUTER_PORT:-19082}
RAY_CUDA_VISIBLE_DEVICES=${RAY_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}
NUM_GPUS_PER_NODE_FOR_RAY=${NUM_GPUS_PER_NODE_FOR_RAY:-8}
RAY_START_MAX_ATTEMPTS=${RAY_START_MAX_ATTEMPTS:-2}
RAY_HEAD_START_TIMEOUT_S=${RAY_HEAD_START_TIMEOUT_S:-90}
