+def _coerce_nested_config_dicts(config: PretrainedConfig) -> None:
+    for attr in ("text_config", "vision_config"):
+        nested_config = getattr(config, attr, None)
+        if not isinstance(nested_config, dict):
+            continue
+        sub_configs = getattr(config, "sub_configs", {})
+        config_cls = sub_configs.get(attr)
+        if config_cls is not None:
+            nested_config = config_cls(**nested_config)
+        else:
+            try:
+                nested_config = AutoConfig.for_model(**nested_config)
+            except ValueError:
+                nested_config = PretrainedConfig.from_dict(nested_config)
+        setattr(config, attr, nested_config)
+
